[Unit]
Description=Mira portrait generator on the second V100
After=network-online.target

[Service]
WorkingDirectory=%h/mira-photo
ExecStart=%h/mira-photo/.venv/bin/python %h/mira-photo/worker.py
Environment=CUDA_VISIBLE_DEVICES=GPU-5cc54044-df38-0b75-15d6-a9e419fd2b5e
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
