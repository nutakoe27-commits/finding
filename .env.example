# Local endpoint forwarded by your existing SSH tunnel. Enable both variables
# after checking the tunnel's actual local port and GET /v1/models.
# QWEN_BASE_URL=http://127.0.0.1:23333/v1
# QWEN_MODEL=QuantTrio/Qwen3.5-35B-A3B-AWQ
# QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=90
# vLLM / Qwen 3.5: disable thinking for short statistical explanations.
# Leave unset for servers that do not accept chat_template_kwargs.
# QWEN_ENABLE_THINKING=false
QWEN_MAX_TOKENS=1024
# Match analysis: discover the real server context; cap input per call separately.
QWEN_CONTEXT_TOKENS=0
QWEN_BATCH_TOKENS=4096
QWEN_PARALLELISM=1
QWEN_ANALYSIS_TIMEOUT_SECONDS=120
# Website match analyses run as persisted jobs; 30–1800 seconds, default 15 minutes.
# This budget is separate from synchronous checks and legacy /explain requests.
QWEN_JOB_TIMEOUT_SECONDS=900
# Whole source markets sent to AI; 2–20, or 0 to retain the complete market pool.
# Selected market and primary outcome have priority; paired table rows stay together.
QWEN_MARKET_LIMIT=8
# Qualitative P1/P2 or skip, without the independent probability model.
# Enable with scripts/configure_neural_verdict.py; existing mode stays default.
EVENT_ANALYSIS_MODE=independent
# Percent of a separate gaming bankroll: small = half, standard = this ceiling.
# Allowed 0.01–0.5; not a probability, never set by free-form model text.
VERDICT_MAX_STAKE_PCT=0.5
# Standalone search diagnostics only; match analyses do not call internet search.
# MCP endpoint forwarded over SSH from Wigolo on the AI server.
# WIGOLO_MCP_URL=http://127.0.0.1:13333/mcp
# WIGOLO_MCP_TOKEN_FILE=/etc/matchlab-wigolo-token
# MATCHLAB_DATA_DIR=/absolute/path/to/persistent/data
# Generated securely by scripts/configure_bookmaker_receiver.py; never commit its value.
# BOOKMAKER_INGEST_TOKEN=

# Required canonical HTTPS origin for accounts; cookies are Secure on HTTPS.
PUBLIC_ORIGIN=https://prognozich.online
# Generation request cap; 0 means unlimited. Paid unlocks use a separate balance.
AI_DAILY_LIMIT=0
# YooKassa: configure_yookassa.py --live asks for credentials with hidden input.
BILLING_ENABLED=false
BILLING_MODE=test
# Рабочий магазин с собственной онлайн-кассой, подключённой к ЮKassa.
BILLING_RECEIPTS_ENABLED=false
# 0: СНО из настроек кассы. УСН: 2 — доходы, 3 — доходы минус расходы.
YOOKASSA_TAX_SYSTEM_CODE=0
# Only for controlled test-store checks; ignored for live checkout.
BILLING_PUBLIC_TESTING=false
# Leave empty for SQLite. Set only after a verified migration to a separate DB.
MATCHLAB_DATABASE_URL=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional social login. Secrets are server-only; use configure_social_login.py.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# One VK ID web app supports the VK, OK and Mail.ru buttons (OAuth 2.1 + PKCE).
VKID_CLIENT_ID=

# Enable only after YooKassa approves recurring payments for this shop.
BILLING_RECURRING_ENABLED=false
# Generated locally with python -m matchlab.manage init-push. Never commit private keys.
# WEBPUSH_PRIVATE_KEY_FILE=/absolute/path/to/webpush-private.pem
# WEBPUSH_PUBLIC_KEY=
# WEBPUSH_SUBJECT=https://prognozich.online
